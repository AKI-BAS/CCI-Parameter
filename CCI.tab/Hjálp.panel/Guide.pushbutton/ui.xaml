<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="1080" Height="760" MinWidth="720" MinHeight="460"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="True"
        ResizeMode="CanResizeWithGrip" FontSize="13" Background="White">
  <DockPanel>
    <Border DockPanel.Dock="Top" Background="#5B4B8A" Padding="18,12">
      <StackPanel>
        <TextBlock x:Name="head_t" Foreground="White" FontSize="20"
                   FontWeight="SemiBold"/>
        <TextBlock x:Name="head_s" Foreground="#E4DEF5" Margin="0,2,0,0"
                   TextWrapping="Wrap"/>
      </StackPanel>
    </Border>
    <Border DockPanel.Dock="Bottom" BorderBrush="#DDD"
            BorderThickness="0,1,0,0" Padding="12,8">
      <DockPanel>
        <Button x:Name="close_b" DockPanel.Dock="Right" MinWidth="90"
                Padding="10,4" IsCancel="True" Click="close_click"/>
        <TextBlock x:Name="foot_t" Foreground="Gray"
                   VerticalAlignment="Center" TextWrapping="Wrap"/>
      </DockPanel>
    </Border>
    <TabControl x:Name="tabs" Margin="8" TabStripPlacement="Left"
                Padding="0">
      <TabControl.Resources>
        <Style TargetType="TabItem">
          <Setter Property="Padding" Value="14,8"/>
          <Setter Property="MinWidth" Value="170"/>
          <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>
      </TabControl.Resources>
    </TabControl>
  </DockPanel>
</Window>
